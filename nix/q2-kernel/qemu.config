# Extra configuration for booting the kernel under QEMU's -M virt machine.
# The Rockchip DRM driver queries the DRAM layout through SIP SMC calls,
# which trap without EL3 firmware under QEMU.
CONFIG_DRM_ROCKCHIP=n
# The vendor tree wires panel-simple into the rockchip drm core.
CONFIG_DRM_PANEL_SIMPLE=n
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_POWER_RESET=y
